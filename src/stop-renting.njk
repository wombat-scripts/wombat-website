<section class="section ads-hero">
  <div class="container ads-hero__grid">
    <div class="ads-hero__copy">
      <h1 class="display">Still renting, even though your income is fine?</h1>
      <p class="lede">If 20% cash is not sitting there, you still may have a door. Leave your details. Tom will call back to book a Strategy Session.</p>
    </div>

    <div class="ads-hero__form-wrap">
      <div class="ads-form-card" data-stop-renting-panel>
        {# Zap/webhook can hook form name stop-renting-callback later #}
        <form class="ads-form"
              name="stop-renting-callback"
              method="POST"
              action="/stop-renting/"
              netlify
              data-netlify="true"
              netlify-honeypot="bot-field"
              data-netlify-honeypot="bot-field"
              data-stop-renting-form
              novalidate>
          <input type="hidden" name="form-name" value="stop-renting-callback">
          <p class="ads-form__honeypot">
            <label>Do not fill this out if you are human <input type="text" name="bot-field" tabindex="-1" autocomplete="off"></label>
          </p>

          <p class="ads-form__required muted">Name, email, and mobile required.</p>

          <div class="ads-form__field">
            <label for="stop-renting-name">Name</label>
            <input id="stop-renting-name"
                   class="ads-form__input"
                   type="text"
                   name="name"
                   autocomplete="name"
                   placeholder="Your name"
                   required>
          </div>

          <div class="ads-form__field">
            <label for="stop-renting-email">Email</label>
            <input id="stop-renting-email"
                   class="ads-form__input"
                   type="email"
                   name="email"
                   autocomplete="email"
                   inputmode="email"
                   placeholder="you@email.com"
                   required>
          </div>

          <div class="ads-form__field">
            <label for="stop-renting-phone">Phone</label>
            <input id="stop-renting-phone"
                   class="ads-form__input"
                   type="tel"
                   name="phone"
                   autocomplete="tel"
                   inputmode="tel"
                   placeholder="Mobile number"
                   required>
          </div>

          <button class="btn btn--primary btn--lg ads-form__submit"
                  type="submit"
                  data-umami-event="stop-renting-callback"
                  data-idle-label="Request a callback"
                  data-loading-label="Sending…">
            Request a callback
          </button>

          <p class="ads-form__under">We will call you to find a time for a 30-minute Strategy Session.</p>
          <p class="ads-form__privacy muted">We only use this to call you back about a Strategy Session. No spam list.</p>
          <p class="ads-form__secondary">
            <a href="/book/" data-umami-event="stop-renting-self-book">Or pick a time yourself</a>
          </p>
        </form>

        <p class="ads-form__status ads-form__status--error" data-stop-renting-error hidden>
          Please add a name, email, and mobile so we can call you back.
        </p>
        <div class="ads-form__status ads-form__status--success" data-stop-renting-success hidden>
          <p>Thanks. We will call you soon to lock in a Strategy Session.</p>
          <p class="ads-form__or">Or</p>
          <a class="btn btn--primary" href="/book/" data-umami-event="stop-renting-self-book">Book a time with Tom</a>
        </div>
      </div>
    </div>
  </div>
</section>

