{% block scripts %}
<script>
(function () {
  var form = document.querySelector('[data-stop-renting-form]');
  if (!form) return;

  var errorEl = document.querySelector('[data-stop-renting-error]');
  var successEl = document.querySelector('[data-stop-renting-success]');
  var button = form.querySelector('[type="submit"]');
  var idleLabel = (button && button.getAttribute('data-idle-label')) || 'Request a callback';
  var loadingLabel = (button && button.getAttribute('data-loading-label')) || 'Sending…';
  var validationError = 'Please add a name, email, and mobile so we can call you back.';
  var submitError = 'Something went wrong sending that. Please try again or pick a time at /book/.';

  function hideStatus() {
    if (errorEl) {
      errorEl.textContent = validationError;
      errorEl.hidden = true;
    }
    if (successEl) successEl.hidden = true;
  }

  function showError(message) {
    if (successEl) successEl.hidden = true;
    if (errorEl) {
      errorEl.textContent = message || validationError;
      errorEl.hidden = false;
    }
  }

  function showSuccess() {
    form.hidden = true;
    if (errorEl) errorEl.hidden = true;
    if (successEl) successEl.hidden = false;
    if (window.umami) {
      try { window.umami.track('stop-renting-callback'); } catch (err) {}
    }
  }

  function isFilled(value) {
    return String(value || '').trim().length > 0;
  }

  function isEmail(value) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value || '').trim());
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    hideStatus();

    // Read by stable ids. A named "name" lookup collides with the form
    // name and the hidden form-name input, so the value looks empty.
    var nameEl = document.getElementById('stop-renting-name');
    var emailEl = document.getElementById('stop-renting-email');
    var phoneEl = document.getElementById('stop-renting-phone');
    var name = nameEl && nameEl.value;
    var email = emailEl && emailEl.value;
    var phone = phoneEl && phoneEl.value;

    if (!isFilled(name) || !isEmail(email) || !isFilled(phone)) {
      showError(validationError);
      return;
    }

    if (button) {
      button.disabled = true;
      button.textContent = loadingLabel;
    }

    var endpoint = (window.location && window.location.pathname) || '/stop-renting/';
    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(new FormData(form)).toString(),
      redirect: 'manual'
    }).then(function (res) {
      var status = res.status;
      var redirected = res.type === 'opaqueredirect' || (status >= 300 && status < 400);
      if (!((status >= 200 && status < 300) || redirected)) {
        throw new Error('submit failed');
      }
      showSuccess();
    }).catch(function () {
      if (button) {
        button.disabled = false;
        button.textContent = idleLabel;
      }
      showError(submitError);
    });
  });
})();
</script>
{% endblock %}
