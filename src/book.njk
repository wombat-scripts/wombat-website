---
layout: landing.njk
title: Book a 30-minute strategy session
description: Book a free 30-minute strategy session with Tom Carr on Google Meet. Any profession, any situation. No cost, no obligation.
date: 2026-08-19
---

<section class="section book-hero">
  <div class="container container--narrow" style="text-align: center;">
    <p class="eyebrow">Strategy session · 30 minutes · Google Meet</p>
    <h1 class="display">Book a 30-minute strategy session</h1>
    <p class="lede" style="margin-inline: auto;">
      Banking, teaching, healthcare, trades, or something that doesn't fit a neat box. If you have a home loan question, you're welcome here. Tell me the situation. I'll tell you what's possible.
    </p>
  </div>
</section>

<section class="section book-embed-section">
  <div class="container">
    <div class="book-embed" data-book-embed aria-busy="true">
      <div class="book-embed__wait">
        <p class="book-embed__wait-label" role="status" aria-live="polite">Loading available times…</p>
        <div class="book-embed__card" aria-hidden="true">
          <div class="book-embed__rule"><span></span></div>
          <div class="book-embed__card-head">
            <span class="book-embed__dot"></span>
            <span class="book-embed__month"></span>
            <span class="book-embed__dot"></span>
          </div>
          <div class="book-embed__weekdays">
            <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
          </div>
          <div class="book-embed__days">
            {%- for day in range(35) %}
            <span{% if day == 8 or day == 10 or day == 15 or day == 17 or day == 22 or day == 24 %} class="is-open"{% endif %}></span>
            {%- endfor %}
          </div>
        </div>
      </div>
      <div class="calendly-inline-widget"
           data-url="{{ site.calendlyEvent }}?hide_event_type_details=1&amp;hide_gdpr_banner=1"
           data-resize="true"
           style="min-width:320px;height:700px;"
           data-umami-event="calendly-embed"></div>
      <script>
        (function () {
          "use strict";

          var root = document.querySelector("[data-book-embed]");
          if (!root) return;

          var wait = root.querySelector(".book-embed__wait");
          var widget = root.querySelector(".calendly-inline-widget");
          var observer = null;
          var iframeGraceMs = 1200;
          var readyEvents = {
            "calendly.event_type_viewed": true,
            "calendly.date_and_time_selected": true,
            "calendly.event_scheduled": true
          };

          function hideWait() {
            if (root.classList.contains("is-ready")) return;
            root.classList.add("is-ready");
            root.setAttribute("aria-busy", "false");
            if (wait) wait.hidden = true;
            if (observer) observer.disconnect();
          }

          function eventName(data) {
            if (!data) return "";
            if (typeof data === "string") {
              try {
                data = JSON.parse(data);
              } catch (err) {
                return "";
              }
            }
            if (typeof data !== "object" || typeof data.event !== "string") return "";
            return data.event;
          }

          window.addEventListener("message", function (event) {
            if (!event || event.origin !== "https://calendly.com") return;
            if (readyEvents[eventName(event.data)]) hideWait();
          });

          function bindIframe(iframe) {
            if (!iframe || iframe.getAttribute("data-book-bound") === "true") return;
            iframe.setAttribute("data-book-bound", "true");
            iframe.addEventListener("load", function () {
              window.setTimeout(hideWait, iframeGraceMs);
            });
          }

          if (widget) {
            var existing = widget.querySelector("iframe");
            if (existing) {
              bindIframe(existing);
            } else {
              observer = new MutationObserver(function () {
                var iframe = widget.querySelector("iframe");
                if (!iframe) return;
                bindIframe(iframe);
                observer.disconnect();
                observer = null;
              });
              observer.observe(widget, { childList: true, subtree: true });
            }
          }

          /* Last resort so a missed message cannot cover a usable calendar. */
          window.setTimeout(hideWait, 12000);
        })();
      </script>
      <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
    </div>

    <p class="text-center book-embed__aside">
      Prefer to send details after we talk?
      <a class="btn btn--text" href="{{ site.middle }}" target="_blank" rel="noopener" data-umami-event="start-fact-find" data-umami-event-location="book">Get started in 2 minutes on Middle</a>
    </p>
  </div>
</section>

<section class="section section--cool">
  <div class="container container--narrow">
    <p class="eyebrow">What to expect</p>
    <h2>A strategy session, not a sales meeting.</h2>
    <p>Thirty minutes on Google Meet. You talk through the situation. First home, next move, refinance, investment, or "I'm not sure yet." I tell you whether it's achievable, roughly with whom, and what I'd do next. No paperwork on this call.</p>
    <p>If the honest answer is "not yet," or "someone else is a better fit," I'll say so. Zero cost, zero pressure, zero follow-up sequences.</p>
    <p class="muted">Or call <a href="{{ site.phoneLink }}" data-umami-event="phone-call" data-umami-event-location="book">0456 255 409</a> · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <p class="muted">The fine print: <a href="/privacy-policy/">Privacy Policy &amp; Terms of Use</a>, <a href="/terms/">Terms of Use</a>, and <a href="/dispute-resolution/">Dispute Resolution</a>.</p>
  </div>
</section>
